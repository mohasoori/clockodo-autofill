{
  "manifest_version": 3,
  "name": "Clockodo Auto-Fill",
  "version": "1.3.9",
  "description": "Fill your daily Clockodo working times in one click, for a date range, or automatically every workday.",
  "author": "Mohammad Soori <contact@msoori.com>",
  "homepage_url": "https://msoori.com",
  "minimum_chrome_version": "99",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://my.clockodo.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Clockodo Auto-Fill",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
